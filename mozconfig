# CleanFox — opções de compilação para todas as plataformas.
# Variáveis de ambiente:
#   CLEANFOX_TARGET        linux | windows | macos | android (definida pelos scripts)
#   CLEANFOX_ANDROID_ABI   aarch64 (padrão) | armv7 | x86_64
#   CLEANFOX_FAST_BUILD=1  desliga LTO (compila mais rápido e com menos RAM; binário mais lento)
#   CLEANFOX_PGO=1         liga PGO no desktop (binário mais rápido; a compilação roda duas vezes)

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-cleanfox

# --- Sem telemetria / coleta ---
# MOZILLA_OFFICIAL não é definido de propósito: sem ele MOZ_TELEMETRY_REPORTING fica
# desligado e o código de envio de telemetria do Gecko não é compilado.
# Normandy (estudos) e Health Report são impostos por browser/moz.configure e não dá
# para removê-los por aqui; ficam desligados por prefs travadas em settings/cleanfox.js.
ac_add_options --disable-crashreporter

# --- Segurança ---
# Mantidos de propósito (padrões do Firefox que outros forks desligam):
#   * assinatura obrigatória de extensões
#   * sandbox RLBox/wasm das bibliotecas de terceiros
ac_add_options --enable-hardening

# --- Desempenho e tamanho ---
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --enable-rust-simd
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --enable-strip
ac_add_options --enable-install-strip

case "$CLEANFOX_TARGET" in
  android)
    # Android: GeckoView + Fenix. Nome, ID e arte do app são tratados em
    # scripts/prepare-android.sh (ficam no Gradle, não aqui).
    ac_add_options --enable-project=mobile/android
    ac_add_options --with-branding=mobile/android/branding/unofficial
    # Menos tarefas em paralelo: Gradle + Rust + C++ juntos estouram a memória do runner.
    mk_add_options MOZ_PARALLEL_BUILD=3
    case "${CLEANFOX_ANDROID_ABI:-aarch64}" in
      aarch64) ac_add_options --target=aarch64-linux-android ;;
      armv7) ac_add_options --target=arm-linux-androideabi ;;
      x86_64) ac_add_options --target=x86_64-linux-android ;;
    esac
    ;;
  *)
    ac_add_options --enable-application=browser

    # Identidade: nada de marca Firefox, perfil separado do Firefox instalado.
    ac_add_options --with-app-name=cleanfox
    ac_add_options --with-app-basename=CleanFox
    ac_add_options --with-branding=browser/branding/cleanfox
    ac_add_options --with-distribution-id=io.github.cleanfox

    # Sem atualizador da Mozilla: atualizações vêm dos releases do CleanFox.
    ac_add_options --disable-updater

    # Fora da compilação: controle parental do sistema operacional e a varredura de
    # redes Wi-Fi vizinhas (só servia para localização mais precisa).
    ac_add_options --disable-parental-controls
    ac_add_options --disable-necko-wifi

    if [ -z "$CLEANFOX_FAST_BUILD" ]; then
      ac_add_options --enable-lto=cross
    fi
    if [ -n "$CLEANFOX_PGO" ]; then
      ac_add_options MOZ_PGO=1
    fi
    ;;
esac

if [ "$CLEANFOX_TARGET" = windows ]; then
  # Serviços residentes do Windows: atualização em segundo plano e o agente que
  # reporta à Mozilla qual é o navegador padrão.
  ac_add_options --disable-maintenance-service
  ac_add_options --disable-default-browser-agent
  ac_add_options --disable-bits-download
fi
